{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"PCDealHub Verified Deal",
  "type":"array",
  "items":{
    "type":"object",
    "additionalProperties":false,
    "required":["id","name","category","price","reference","score","seller","url","checked_at","condition","verification"],
    "properties":{
      "id":{"type":"string","minLength":3},
      "name":{"type":"string","minLength":3},
      "category":{"enum":["GPU","CPU","RAM","SSD","PC","MONITOR"]},
      "price":{"type":"number","exclusiveMinimum":0},
      "reference":{"type":"number","exclusiveMinimum":0},
      "score":{"type":"number","minimum":0,"maximum":10},
      "seller":{"type":"string","minLength":2},
      "url":{"type":"string","format":"uri"},
      "original_url":{"type":"string","format":"uri"},
      "affiliate_url":{"type":"string","format":"uri"},
      "affiliate_network":{"type":"string"},
      "checked_at":{"type":"string","format":"date-time"},
      "offer_expires_at":{"type":"string","format":"date-time"},
      "condition":{"type":"string","minLength":2},
      "stock":{"type":"string"},
      "warranty":{"type":"string"},
      "icon":{"type":"string"},
      "verification":{
        "type":"object","additionalProperties":false,
        "required":["price","seller","availability","terms"],
        "properties":{
          "price":{"type":"boolean"},"seller":{"type":"boolean"},"availability":{"type":"boolean"},"terms":{"type":"boolean"},"reference_price":{"type":"boolean"}
        }
      }
    }
  }
}